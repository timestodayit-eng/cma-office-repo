// CMA Office database. One database shared by web, desktop and mobile apps.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Level {
  SUPER_ADMIN
  ADMIN
  MANAGER
  STAFF
}

enum Access {
  OFF
  VIEW
  EDIT
}

model User {
  id           String   @id @default(cuid())
  name         String
  shortName    String?
  phone        String   @unique
  email        String?  @unique
  passwordHash String
  level        Level    @default(STAFF)
  department   String?
  designation  String?
  jdCode       String?
  whatsapp     String?
  whatsappOn   Boolean  @default(true)
  /**
   * Freelance / support partner: no attendance, no payroll.
   */
  external     Boolean  @default(false)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  permissions      ModulePermission[]
  responsibilities Responsibility[]
  companyRoles     CompanyRole[]
  tasks            Task[]             @relation("assignee")
  checkingTasks    Task[]             @relation("checker")
  taskEvents       TaskEvent[]
  requestsSent     Request[]          @relation("from")
  requestsReceived Request[]          @relation("to")
  notifications    Notification[]
  leaveRequests    LeaveRequest[]     @relation("leaveOf")
  interviews       Interview[]        @relation("createdBy")
  attendance       Attendance[]
  payslips         Payslip[]
  noticesSent      Notice[]
  noticeReads      NoticeRead[]
  ownTasks         OwnTask[]
  workSessions     WorkSession[]
  screenshots      Screenshot[]
  devices          Device[]
}

model ModulePermission {
  id     String @id @default(cuid())
  userId String
  module String
  access Access @default(OFF)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module])
}

model Responsibility {
  id           String   @id @default(cuid())
  userId       String
  key          String
  /**
   * Company ids this applies to (empty = all).
   */
  companies    String[]
  /**
   * Content types this applies to (uploader). Empty = all.
   */
  contentTypes String[]
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model Company {
  id        String   @id @default(cuid())
  name      String   @unique
  short     String   @unique
  /**
   * Banglalink hotline series, e.g. ["80","50"].
   */
  hotlines  String[]
  sheetTab  String?
  sortOrder Int      @default(0)

  roles      CompanyRole[]
  interviews Interview[]
  tasks      Task[]
}

/// Who holds a role for a company (writer, model, editor x2, qc, ads, broadcast, uploader).
/// Global roles (creative_lead, content_director, cinematographer) use companyId = null.
model CompanyRole {
  id        String   @id @default(cuid())
  companyId String?
  role      String
  userId    String
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, role, userId])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// One interview event. Also the row of the Recruitment Command Center sheet.
model Interview {
  id               String   @id @default(cuid())
  companyId        String
  country          String
  interviewDate    DateTime @db.Date
  title            String?
  status           String   @default("Upcoming")
  // Recruitment sheet numbers
  marketingPlanUsd Decimal? @db.Decimal(12, 2)
  totalCostUsd     Decimal? @db.Decimal(12, 2)
  totalCostBdt     Decimal? @db.Decimal(14, 2)
  rateBdt          Decimal? @db.Decimal(8, 2)
  passports        Int?
  leads            Int?
  topUpRequired    Boolean  @default(false)
  notes            String?
  workType         String?
  details          String?
  /**
   * Banglalink panel: FIRST / SECOND / SINGLE (bridge pairs).
   */
  broadcastType    String?
  /**
   * Sheet sync: tab + row id so two-way sync can find it again.
   */
  sheetRef         String?  @unique
  bridgeWithId     String?
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company   Company         @relation(fields: [companyId], references: [id])
  createdBy User?           @relation("createdBy", fields: [createdById], references: [id])
  tasks     Task[]
  broadcast BroadcastSlot[]

  @@index([interviewDate])
}

enum TaskStatus {
  WAITING // earlier step not done yet
  TODO
  IN_PROGRESS
  DONE
  SKIPPED
}

model Task {
  id           String     @id @default(cuid())
  interviewId  String?
  companyId    String?
  chain        String? // "video" for interview chains, null for a simple task
  stepKey      String?
  order        Int        @default(0)
  title        String
  description  String?
  /**
   * Role that owns the step; for pool steps the assignee is set when someone claims it.
   */
  role         String?
  pool         Boolean    @default(false)
  assigneeId   String?
  checkerId    String?
  status       TaskStatus @default(WAITING)
  startDate    DateTime?  @db.Date
  dueDate      DateTime?  @db.Date
  startedAt    DateTime?
  doneAt       DateTime?
  scriptLink   String?
  driveLink    String?
  videoLink    String?
  postLink     String?
  handoverNote String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  interview Interview?  @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  company   Company?    @relation(fields: [companyId], references: [id])
  assignee  User?       @relation("assignee", fields: [assigneeId], references: [id])
  checker   User?       @relation("checker", fields: [checkerId], references: [id])
  events    TaskEvent[]
  requests  Request[]

  @@index([assigneeId, status])
  @@index([interviewId])
}

model TaskEvent {
  id        String   @id @default(cuid())
  taskId    String
  userId    String?
  type      String // created, started, done, already_done, claimed, qc_pass, qc_fail, reassigned, note
  note      String?
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])
}

enum RequestType {
  REVIEW
  QC
  MODIFY
  APPROVAL
  RAW_FILE
  CUSTOM
}

model Request {
  id         String      @id @default(cuid())
  fromId     String
  toId       String
  type       RequestType
  taskId     String?
  message    String
  status     String      @default("OPEN") // OPEN, ANSWERED
  answer     String?
  answeredAt DateTime?
  createdAt  DateTime    @default(now())

  from User  @relation("from", fields: [fromId], references: [id])
  to   User  @relation("to", fields: [toId], references: [id])
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([toId, status])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String // task, request, qc, broadcast, hr
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  /**
   * WhatsApp delivery (phase 2): null = not sent, queued, sent, failed
   */
  whatsapp  String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

/// Log Sheet: one row = one line of a day tab ("18 Nov").
model LogRow {
  id               String   @id @default(cuid())
  date             DateTime @db.Date
  sn               Int?
  title            String?
  deadline         String?
  priority         String?
  company          String?
  mainCategory     String?
  contentType      String?
  scriptWriter     String?
  scriptLink       String?
  presenter        String?
  cinematographer  String?
  videoEditor      String?
  status           String?
  thumbnail        String?
  rawFile          String?
  finalOutput      String?
  comments         String?
  uploadFacebook   String?
  uploadYoutube    String?
  uploadTiktok     String?
  platformFacebook String?
  platformYoutube  String?
  platformTiktok   String?
  finalComments    String?
  rowIndex         Int      @default(0)
  taskId           String?
  sheetRef         String?  @unique
  updatedAt        DateTime @updatedAt

  @@index([date])
  @@index([status])
}

/// Banglalink call broadcast: V1..V7 per interview, two ticks per slot.
model BroadcastSlot {
  id           String    @id @default(cuid())
  interviewId  String
  slot         String
  callDate     DateTime  @db.Date
  missedSent   Boolean   @default(false)
  missedAt     DateTime?
  receivedSent Boolean   @default(false)
  receivedAt   DateTime?
  smsSent      Boolean   @default(false)
  sentById     String?
  interview    Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@unique([interviewId, slot])
  @@index([callDate])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  data      Json?
  createdAt DateTime @default(now())
}

/// Changes made in the app waiting to be written to a Google Sheet (two-way sync).
model SheetOutbox {
  id        String    @id @default(cuid())
  sheet     String // recruitment | broadcast | log
  /**
   * Entity key (sheetRef) so a sheet push does not overwrite a newer app change.
   */
  ref       String?
  op        Json
  tries     Int       @default(0)
  lastError String?
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([sentAt, sheet])
  @@index([ref])
}

/// One row per person per day. Check-in is accepted only from the office WiFi (router MAC) or set by an admin.
/// A leave application: staff ask, HR / CEO approve or reject and decide paid or unpaid.
/// When approved, each working day in the range becomes a LEAVE day in Attendance.
model LeaveRequest {
  id           String    @id @default(cuid())
  userId       String
  fromDate     DateTime  @db.Date
  toDate       DateTime  @db.Date
  /// Working days in the range (weekly off days not counted)
  days         Int
  /// CASUAL, SICK, EMERGENCY, UNPAID, OTHER
  type         String
  reason       String
  /// PENDING, APPROVED, REJECTED, CANCELLED
  status       String    @default("PENDING")
  paid         Boolean?
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation("leaveOf", fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId, fromDate])
}

model Attendance {
  id         String    @id @default(cuid())
  userId     String
  date       DateTime  @db.Date
  checkIn    DateTime?
  checkOut   DateTime?
  late       Boolean   @default(false)
  /// wifi = from the mobile app on office WiFi, admin = set by HR/admin
  method     String    @default("wifi")
  /// PRESENT, LEAVE, ABSENT (the last two are set by an admin)
  status     String    @default("PRESENT")
  bssid      String?
  note       String?
  editedById String?
  /// Set when the day comes from an approved leave application
  leaveId    String?
  /// For LEAVE days: false = unpaid leave (payroll cuts the day)
  paidLeave  Boolean?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
}

/// One row per person per month, created when an admin edits or finalises that month's pay.
/// While DRAFT the numbers are worked out live from attendance; FINAL keeps a fixed copy.
model Payslip {
  id            String    @id @default(cuid())
  userId        String
  /// "2026-11"
  month         String
  status        String    @default("DRAFT")
  /// Admin's own number of unpaid days; null = use the number worked out from attendance
  unpaidDays    Decimal?  @db.Decimal(5, 1)
  bonus         Decimal   @default(0) @db.Decimal(12, 2)
  deduction     Decimal   @default(0) @db.Decimal(12, 2)
  /// Overtime hours of the month, paid at basic / days / hours per day
  overtimeHours Decimal   @default(0) @db.Decimal(6, 1)
  /// Made by "Add demo data"; removed with it
  demo          Boolean   @default(false)
  note          String?
  /// Fixed copy of every figure, written when the month is finalised
  final         Json?
  finalizedById String?
  finalizedAt   DateTime?
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@index([month])
}

/// A notice from the CEO / admin to the whole team, a team, a company's people or chosen people.
model Notice {
  id        String       @id @default(cuid())
  senderId  String
  title     String
  body      String
  /// Who it was sent to, in words ("Everyone", "Production team", ...)
  audience  String
  createdAt DateTime     @default(now())
  sender    User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  reads     NoticeRead[]

  @@index([createdAt])
}

/// One row per person who got the notice; readAt is set when they tick "Yes, I have read it".
model NoticeRead {
  id       String    @id @default(cuid())
  noticeId String
  userId   String
  readAt   DateTime?
  notice   Notice    @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noticeId, userId])
  @@index([userId, readAt])
}

/// A task a person gives to themselves. Private: only that person sees it.
model OwnTask {
  id        String    @id @default(cuid())
  userId    String
  title     String
  dueDate   DateTime? @db.Date
  doneAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, doneAt])
}

/// Work Monitor: one "Start work" to "Stop work" on the desktop app.
/// Screenshots and activity are only recorded inside a session.
model WorkSession {
  id         String           @id @default(cuid())
  userId     String
  startedAt  DateTime         @default(now())
  /// Null while working. Set by Stop work, or by the server when the app goes silent.
  endedAt    DateTime?
  lastBeatAt DateTime         @default(now())
  /// stop = Stop work, lock = PC locked / slept, quit = app closed, silent = app stopped reporting, logout
  endReason  String?
  device     String?
  activeSec  Int              @default(0)
  idleSec    Int              @default(0)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  shots      Screenshot[]
  samples    ActivitySample[]

  @@index([userId, startedAt])
  @@index([endedAt])
}

/// A compressed JPEG on the server's disk (SHOTS_DIR). Only Work Monitor admins can open it.
model Screenshot {
  id        String      @id @default(cuid())
  sessionId String
  userId    String
  takenAt   DateTime
  /// Path under SHOTS_DIR, e.g. 2026-11-18/<userId>/<id>.jpg
  file      String
  bytes     Int
  screen    Int         @default(0)
  app       String?
  title     String?
  session   WorkSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, takenAt])
  @@index([takenAt])
}

/// One row per minute of a work session: the app in front, its window title and whether the person was idle.
model ActivitySample {
  id        String      @id @default(cuid())
  sessionId String
  userId    String
  at        DateTime
  app       String?
  title     String?
  idle      Boolean     @default(false)
  session   WorkSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId, at])
  @@index([sessionId])
}

/// A company desktop computer running the CMA Office app. One row per machine
/// (by the stable deviceId the app stores). Used for IT asset tracking: who is
/// logged in, when it was last online, and its last known area (from the public
/// IP). Visible only to Work Monitor admins. This is disclosed, transparent
/// tracking on company machines; it is not covert monitoring.
model Device {
  id           String    @id @default(cuid())
  /// Stable id the desktop app generates once and keeps in its config.
  deviceId     String    @unique
  /// Computer name (os.hostname()).
  machineName  String?
  platform     String?
  osVersion    String?
  appVersion   String?
  /// The person logged in to the app on this machine the last time it reported.
  userId       String?
  lastSeenAt   DateTime  @default(now())
  /// Public IP the last report came from, and the area looked up from it.
  publicIp     String?
  city         String?
  region       String?
  country      String?
  /// Approximate coordinates from the IP lookup (city-level, not GPS).
  lat          Float?
  lng          Float?
  /// When the IP -> area lookup last ran, so we do not look up on every beat.
  geoAt        DateTime?
  createdAt    DateTime  @default(now())
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([lastSeenAt])
  @@index([userId])
}
