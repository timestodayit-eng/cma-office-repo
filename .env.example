# Copy to .env on the VPS and fill in. Never commit .env.
DB_PASSWORD=change-me-long-random
# 32+ random characters: openssl rand -hex 32
SESSION_SECRET=
# Domain pointing at the VPS (e.g. office.yourcompany.com). For a first test use the VPS IP.
DOMAIN=office.example.com
# Load the team on first start (safe to leave on; existing users are not overwritten)
SEED_ON_START=1
